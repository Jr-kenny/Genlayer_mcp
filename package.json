{
  "name": "genlayer-docs-mcp",
  "version": "2.2.0",
  "description": "An MCP server for GenLayer documentation search and live protocol RPC inspection.",
  "main": "dist/cli.js",
  "bin": {
    "genlayer-docs-mcp": "dist/cli.js",
    "genlayer-docs-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js dist/http.js",
    "check": "npm run build && node dist/cli.js --check",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "start:http": "node dist/http.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "genlayer",
    "documentation",
    "json-rpc",
    "contracts",
    "claude-code",
    "codex"
  ],
  "author": "Jr-kenny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jr-kenny/Genlayer_mcp.git"
  },
  "homepage": "https://github.com/Jr-kenny/Genlayer_mcp#readme",
  "bugs": {
    "url": "https://github.com/Jr-kenny/Genlayer_mcp/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
